# Large data files. The small bundled test dataset under test_data/fastq/ is
# deliberately tracked (see test_data/README.md); heavy sequence files
# elsewhere are not.
*.fastq
*.fq
/**/rawdata/*.fastq.gz
/**/rawdata/*.fq.gz
!test_data/fastq/*.fastq.gz
