#!/usr/bin/env python3

# resscan/scripts/resscan_aggregate
import argparse
import csv
import pandas as pd
import sys
import time
from pathlib import Path

class Colors:
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'

def read_samplesheet_ids(samplesheet):
    """
    Sample IDs in samplesheet order.

    Rows carry a variable number of fastq columns (single-end, paired-end,
    multi-run), so the file is read line by line and only column 0 is taken;
    pandas would require a fixed column count.
    """
    seen = set()
    ids = []
    with open(samplesheet, newline='') as fh:
        for row in csv.reader(fh, skipinitialspace=True):
            if not row or not row[0].strip() or row[0].strip().startswith('#'):
                continue
            sid = row[0].strip()
            if sid.lower() == 'sample' or sid in seen:
                continue
            seen.add(sid)
            ids.append(sid)
    return ids


PROVENANCE_KEYS = ["ResScan_Version", "Database_CARD_Version", "Database_Reference_FASTA_MD5",
                   "Database_Manifest", "Param_homscan_min_aln_len", "Param_homscan_min_aln_frac",
                   "Param_homscan_pid_cutoff", "Param_homscan_pid_type"]


def read_sample_provenance(input_dir, sample_ids):
    """Reads each sample's provenance file, where one was written."""
    found = {}
    for sid in sample_ids:
        path = Path(input_dir) / sid / f"{sid}_results" / f"{sid}_results_provenance.txt"
        if not path.exists():
            continue
        values = {}
        try:
            with open(path) as fh:
                for line in fh:
                    line = line.strip()
                    if not line or line.startswith('#') or '\t' not in line:
                        continue
                    key, _, value = line.partition('\t')
                    values[key.strip()] = value.strip()
        except IOError:
            continue
        if values:
            found[sid] = values
    return found


def write_aggregate_provenance(args, sample_ids, provenance):
    """
    Records what produced the aggregated tables, and whether the samples agree.

    Samples processed with different ResScan versions or different reference
    databases are not strictly comparable, and the aggregated matrices give no
    hint of it, so any disagreement is reported here and on the console.
    """
    out_path = Path(args.output_dir) / f"{args.prefix}_provenance.txt"
    conflicts = []
    summary = {}
    for key in PROVENANCE_KEYS:
        seen = sorted({v[key] for v in provenance.values() if key in v})
        if not seen:
            continue
        summary[key] = seen[0] if len(seen) == 1 else "MIXED: " + "; ".join(seen)
        if len(seen) > 1:
            conflicts.append(key)

    missing = [s for s in sample_ids if s not in provenance]

    try:
        with open(out_path, 'w') as f:
            f.write("# ResScan aggregation provenance.\n")
            f.write("# Summarises the software and reference database behind the aggregated tables.\n")
            f.write(f"Aggregation_Date\t{time.strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"Aggregation_Command\t{' '.join(sys.argv)}\n")
            f.write(f"Samplesheet\t{args.samplesheet}\n")
            f.write(f"Samples_In_Samplesheet\t{len(sample_ids)}\n")
            f.write(f"Samples_With_Provenance\t{len(provenance)}\n")
            if missing:
                f.write(f"Samples_Without_Provenance\t{', '.join(missing)}\n")
            for key, value in summary.items():
                f.write(f"{key}\t{value}\n")
            f.write(f"Consistent\t{'no' if conflicts else 'yes'}\n")
            if conflicts:
                f.write(f"Inconsistent_Fields\t{', '.join(conflicts)}\n")

            f.write("\n# Per-sample detail\n")
            f.write("Sample\t" + "\t".join(PROVENANCE_KEYS) + "\n")
            for sid in sample_ids:
                vals = provenance.get(sid, {})
                f.write(sid + "\t" + "\t".join(vals.get(k, "NA") for k in PROVENANCE_KEYS) + "\n")
    except IOError as e:
        print(f"{Colors.WARNING}Could not write aggregation provenance: {e}{Colors.ENDC}")
        return

    if conflicts:
        print(f"\n{Colors.FAIL}  WARNING: samples were not all produced the same way.{Colors.ENDC}")
        for key in conflicts:
            print(f"{Colors.WARNING}    {key}: {summary[key]}{Colors.ENDC}")
        print(f"{Colors.WARNING}    Aggregated values may not be comparable across these samples."
              f" See {out_path.name}.{Colors.ENDC}")
    elif provenance:
        v = summary.get("ResScan_Version", "unknown")
        print(f"{Colors.GREEN}  - Provenance: all {len(provenance)} samples from ResScan {v}"
              f" on one database.{Colors.ENDC}")
    if missing:
        print(f"{Colors.WARNING}  - No provenance file for {len(missing)} sample(s); "
              f"they predate provenance recording.{Colors.ENDC}")


def aggregate_samplesheet(args, report_type, suffix_map):
    print(f"{Colors.CYAN}Processing {report_type} reports...{Colors.ENDC}")

    try:
        all_sample_ids = read_samplesheet_ids(args.samplesheet)

        if not all_sample_ids:
            print(f"{Colors.FAIL}No valid Sample IDs found in samplesheet.{Colors.ENDC}")
            return False

    except Exception as e:
        print(f"{Colors.FAIL}Error reading samplesheet: {e}{Colors.ENDC}")
        return False

    all_dfs = []
    missing_samples = []
    empty_samples = []
    found_count = 0

    for sid in all_sample_ids:
        sample_dir = Path(args.input_dir) / sid
        result_sub_dir = sample_dir / f"{sid}_results"
        expected_file = result_sub_dir / f"{sid}_results{suffix_map[report_type]}"

        if expected_file.exists():
            try:
                df = pd.read_csv(expected_file, sep='\t')
                df.columns = [c.lstrip('#').strip() for c in df.columns]

                if df.empty or len(df) == 0:
                    empty_samples.append(sid)
                else:
                    df['Sample'] = sid
                    all_dfs.append(df)
                    found_count += 1
            except Exception:
                empty_samples.append(sid)
        else:
            missing_samples.append(sid)

    if all_dfs:
        combined_df = pd.concat(all_dfs, ignore_index=True)

        for const_col in ("Gene_Length_bp", "Gene_Length_AA"):
            if const_col in combined_df.columns:
                combined_df = combined_df.drop(columns=[const_col])

        potential_ids = ["AMR_Gene_Family", "ARO", "ARO_Name", "Drug_Class",
                         "Resistance_Mechanism", "USCG_ID"]
        id_cols = [c for c in potential_ids if c in combined_df.columns]

        # Effective_Length_bp is kept rather than dropped alongside Gene_Length_bp:
        # it varies between samples whenever read length or alignment settings
        # differ, so the per-sample matrix records what correction was applied.
        potential_metrics = [
            "Read_Count", "Fragment_Count", "Lateral_Coverage_%", "Coverage_Depth",
            "Effective_Length_bp",
            "RPK", "FPK", "RPKG", "FPKG", "RPKM", "FPKM",
            "RPKPC", "FPKPC", "RPKPMC", "FPKPMC", "RPKPGC", "FPKPGC"
        ]

        metrics = [m for m in potential_metrics if m in combined_df.columns]

        for metric in metrics:
            pivoted = combined_df.pivot_table(
                index=id_cols,
                columns='Sample',
                values=metric,
                aggfunc='first',
                fill_value=0
            )

            pivoted = pivoted.reindex(columns=all_sample_ids, fill_value=0).reset_index()
            out_file = Path(args.output_dir) / f"{args.prefix}_{report_type}_{metric}.tsv"
            pivoted.to_csv(out_file, sep='\t', index=False)

    print(f"{Colors.GREEN}  - {report_type.upper()} Summary:{Colors.ENDC}")
    print(f"    Total Samples in Sheet: {len(all_sample_ids)}")
    print(f"    Samples with Hits:      {found_count}")

    if empty_samples:
        print(f"    {Colors.WARNING}Samples with Zero Hits ({len(empty_samples)}):{Colors.ENDC} {', '.join(empty_samples)}")

    if missing_samples:
        print(f"    {Colors.FAIL}Samples Missing Files ({len(missing_samples)}):{Colors.ENDC} {', '.join(missing_samples)}")

    return True

def main():
    start_time = time.monotonic()
    parser = argparse.ArgumentParser(description="ResScan Aggregator - Position-based Samplesheet Loading")
    parser.add_argument("-s", "--samplesheet", required=True, help="Path to the same CSV used for the batch run")
    parser.add_argument("-i", "--input-dir", required=True, help="The --out directory from the batch run")
    parser.add_argument("-o", "--output-dir", required=True, help="Where to save the pivoted tables")
    parser.add_argument("-p", "--prefix", default="aggregated", help="Prefix for output TSV files")
    parser.add_argument("--type", choices=['all', 'homscan', 'varscan', 'uscg'], default='all')

    args = parser.parse_args()
    Path(args.output_dir).mkdir(parents=True, exist_ok=True)

    suffix_map = {
        'homscan': "_homscan.tsv",
        'varscan': "_varscan.tsv",
        'uscg': "_uscg.tsv",
    }

    print(f"\n{Colors.BLUE}{Colors.BOLD}--- ResScan Aggregation Report ---{Colors.ENDC}\n")

    types = ['homscan', 'varscan', 'uscg'] if args.type == 'all' else [args.type]
    for t in types:
        aggregate_samplesheet(args, t, suffix_map)

    sample_ids = read_samplesheet_ids(args.samplesheet)
    if sample_ids:
        write_aggregate_provenance(args, sample_ids, read_sample_provenance(args.input_dir, sample_ids))

    print(f"\n{Colors.BLUE}Finished in {int(time.monotonic()-start_time)} seconds.{Colors.ENDC}")

if __name__ == "__main__":
    main()
